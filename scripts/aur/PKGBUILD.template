# Maintainer: Mohammed Sakarwala <268301699+mohammed160209@users.noreply.github.com>
#
# Canonical PKGBUILD template for the `wispr-flow-appimage` Arch / CachyOS
# package. Fill placeholders with:
#   %%PKGVER%%          -> <wisprVer>_<repoVer> or <wisprVer>-<repoVer>
#   %%RELEASE_TAG%%     -> v<wisprVer>-<repoVer>
#   %%APPIMAGE_NAME%%   -> wispr-flow-<wisprVer>-<repoVer>.AppImage
#   %%SHA256_APPIMAGE%% -> sha256 of that AppImage
#
# Packages the self-contained AppImage (extracted cleanly under /opt so FUSE is
# not required at runtime) with PipeWire system audio capture & XWayland pill
# shape support enabled out of the box.

pkgname=wispr-flow-appimage
pkgver=%%PKGVER%%
pkgrel=1
pkgdesc="Wispr Flow voice dictation & Notetaker for Linux (Arch/CachyOS build with PipeWire system audio capture)"
arch=('x86_64')
url="https://github.com/mohammed160209/wispr-flow-linux"
license=('LicenseRef-proprietary')
depends=('gtk3' 'nss' 'alsa-lib' 'pipewire' 'pipewire-pulse' 'libpulse')
optdepends=(
	'wl-clipboard: clipboard paste-injection on Wayland'
	'xclip: clipboard paste-injection on X11'
)
provides=('wispr-flow')
conflicts=('wispr-flow')
options=(!strip)

_appimage=%%APPIMAGE_NAME%%
source=("${_appimage}::https://github.com/mohammed160209/wispr-flow-linux/releases/download/%%RELEASE_TAG%%/${_appimage}")
sha256sums=('%%SHA256_APPIMAGE%%')
noextract=("${_appimage}")

package() {
	cd "${srcdir}"
	chmod +x "${_appimage}"
	"./${_appimage}" --appimage-extract >/dev/null

	install -dm755 "${pkgdir}/opt/${pkgname}"
	cp -a squashfs-root/. "${pkgdir}/opt/${pkgname}/"

	install -dm755 "${pkgdir}/usr/bin"
	cat <<'EOF' > "${pkgdir}/usr/bin/wispr-flow"
#!/usr/bin/env bash
if [[ -z ${WISPR_USE_X11:-} && -z ${WISPR_USE_WAYLAND:-} && ${XDG_CURRENT_DESKTOP:-} == *GNOME* ]]; then
	export WISPR_USE_X11=1
fi
exec /opt/wispr-flow-appimage/AppRun "$@"
EOF
	chmod 755 "${pkgdir}/usr/bin/wispr-flow"

	local desktop
	desktop=$(find squashfs-root -maxdepth 1 -name '*.desktop' | head -1)
	if [[ -n "${desktop}" ]]; then
		install -Dm644 "${desktop}" \
			"${pkgdir}/usr/share/applications/${pkgname}.desktop"
		sed -i \
			-e 's|^Exec=.*|Exec=wispr-flow %U|' \
			-e 's|^Icon=.*|Icon=wispr-flow|' \
			"${pkgdir}/usr/share/applications/${pkgname}.desktop"
	fi

	local icon
	icon=$(find squashfs-root -name '*.png' | sort | tail -1)
	if [[ -n "${icon}" ]]; then
		install -Dm644 "${icon}" \
			"${pkgdir}/usr/share/icons/hicolor/512x512/apps/wispr-flow.png"
	fi
}
